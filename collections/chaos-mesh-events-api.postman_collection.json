          "request": {
            "name": "Chaos Mesh List chaos events",
            "description": {
              "content": "Returns a list of chaos experiment events from the Chaos Mesh event store. Events record state transitions and fault injection activities. Results can be filtered by object UID, namespace, name, kind, and time range.",
