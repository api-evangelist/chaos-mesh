                  "description": "Filter events by chaos kind."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Filter events from this timestamp (RFC3339)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "Filter events up to this timestamp (RFC3339)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Maximum number of events to return."
